<mxfile host="app.diagrams.net" agent="dsh" version="24.7.17">
  <diagram id="arena-flow-v2" name="忍术对战（按用户描述）">
    <mxGraphModel dx="1600" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="note" value="说明：本图采用用户 2026-10-16 的口述结构 —— 「战斗循环 n 局」是嵌在「循环1」内部的一个块，&#10;即：每打满 n 局才进一次奖励面板。n = arenaBattleRounds（当前设置 3）。" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="20" width="900" height="60" as="geometry" />
        </mxCell>

        <mxCell id="start" value="任务开始" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="560" y="110" width="140" height="55" as="geometry" />
        </mxCell>

        <mxCell id="enter" value="首次进场（进场①~③）&#10;dragScene(left) → 角斗场 → 忍术对战" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="520" y="200" width="220" height="55" as="geometry" />
        </mxCell>

        <mxCell id="ready" value="此时应该在战斗准备界面" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="160" y="290" width="240" height="55" as="geometry" />
        </mxCell>

        <mxCell id="loop1" value="循环1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;fontStyle=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="120" y="380" width="960" height="470" as="geometry" />
        </mxCell>

        <mxCell id="panel" value="点奖励面板&#10;领取奖励" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="500" y="420" width="150" height="55" as="geometry" />
        </mxCell>

        <mxCell id="alldone" value="确认是否&#10;领取完奖励？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="480" y="510" width="190" height="80" as="geometry" />
        </mxCell>

        <mxCell id="exitpanel" value="点右边出奖励界面&#10;ARENA_REWARD_EXIT(1245,320)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="740" y="522" width="230" height="55" as="geometry" />
        </mxCell>

        <mxCell id="fightloop" value="战斗循环 n 局&#10;（n = arenaBattleRounds，当前 3）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;fontStyle=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="180" y="630" width="600" height="190" as="geometry" />
        </mxCell>

        <mxCell id="opstart" value="点开战" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="240" y="680" width="140" height="50" as="geometry" />
        </mxCell>

        <mxCell id="doffight" value="战斗" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="420" y="680" width="140" height="50" as="geometry" />
        </mxCell>

        <mxCell id="done1" value="战斗完成&#10;（回准备界面）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="600" y="680" width="150" height="50" as="geometry" />
        </mxCell>

        <mxCell id="ncheck" value="打满 n 局？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="370" y="750" width="180" height="60" as="geometry" />
        </mxCell>

        <mxCell id="endok" value="完成" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1180" y="510" width="130" height="60" as="geometry" />
        </mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="start" target="enter">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="enter" target="ready">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;entryX=0.25;entryY=0;" edge="1" parent="1" source="ready" target="loop1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1" source="loop1" target="panel">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1" source="panel" target="alldone">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="否则" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="alldone" target="exitpanel">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;entryX=0.8;entryY=0;" edge="1" parent="1" source="exitpanel" target="fightloop">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" value="是则跳出循环" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;" edge="1" parent="1" source="alldone" target="endok">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="fightloop" target="opstart">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="opstart" target="doffight">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="doffight" target="done1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="done1" target="ncheck">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e13" value="否 → 下一局" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0;exitY=0.5;" edge="1" parent="1" source="ncheck" target="opstart">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e14" value="是 → 回到循环1 顶部（再点奖励面板）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0;exitY=0;" edge="1" parent="1" source="ncheck" target="loop1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="mark1" value="✅ 与代码一致：claimArenaRewards 内部自己进出面板，&#10;    打完 n 局后回到它 → 再判 done" style="shape=note;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="1140" y="620" width="330" height="55" as="geometry" />
        </mxCell>

        <mxCell id="mark2" value="❌ 实际翻车点：第 3 局打完 → 点入口(793,642) 时&#10;    画面还没回到准备界面，点空/点错 → 落到主界面" style="shape=note;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="1140" y="700" width="330" height="55" as="geometry" />
        </mxCell>

        <mxCell id="e15" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=none;" edge="1" parent="1" source="mark2" target="panel">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
